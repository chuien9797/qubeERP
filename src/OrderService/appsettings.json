{
  "HttpClients": {
    "Product": {
      "ConnectTimeoutSeconds": 2,
      "RequestTimeoutSeconds": 5,
      "MaxRetries": 2,
      "RetryDelayMilliseconds": 100
    },
    "Inventory": {
      "ConnectTimeoutSeconds": 2,
      "RequestTimeoutSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
